<!DOCTYPE html><html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Responsivo</title><style>
    /* Reset */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f1f5f9;
        color: #1e293b;
        line-height: 1.5;
    }

    /* Estrutura principal */
    .dashboard {
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
        background-color: #1e293b;
        color: white;
        padding: 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .logo {
        font-size: 1.5rem;
    }

    .logo span {
        color: #818cf8;
    }

    .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .sidebar nav a {
        color: #cbd5e1;
        text-decoration: none;
        padding: 12px;
        border-radius: 8px;
    }

    .sidebar nav a:hover,
    .sidebar nav a.active {
        background-color: #334155;
        color: white;
    }

    .sidebar-footer {
        margin-top: auto;
        font-size: 0.8rem;
        color: #94a3b8;
    }

    /* Conteúdo principal */
    .main-content {
        min-width: 0;
        padding: 32px;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 32px;
    }

    .topbar h1 {
        font-size: 1.8rem;
    }

    .topbar p {
        color: #64748b;
        font-size: 0.9rem;
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
    }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #c7d2fe;
        color: #3730a3;
        display: grid;
        place-items: center;
        font-weight: bold;
    }

    /* Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .card,
    .chart-card,
    .activity-card {
        background-color: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgb(15 23 42 / 5%);
    }

    .card-label {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 12px;
    }

    .card h2 {
        font-size: clamp(1.25rem, 2vw, 1.8rem);
        margin-bottom: 12px;
        overflow-wrap: anywhere;
    }

    .positive {
        color: #15803d;
        font-size: 0.8rem;
    }

    .negative {
        color: #dc2626;
        font-size: 0.8rem;
    }

    /* Gráfico */
    .chart-card {
        margin-bottom: 24px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

    .section-header h2,
    .activity-card h2 {
        font-size: 1.2rem;
        margin-bottom: 4px;
    }

    .section-header p {
        color: #64748b;
        font-size: 0.9rem;
    }

    .badge {
        background-color: #eef2ff;
        color: #4338ca;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.85rem;
    }

    .chart {
        width: 100%;
        height: auto;
        display: block;
    }

    /* Atividades recentes */
    .activity-card h2 {
        margin-bottom: 16px;
    }

    .activity {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .activity:last-child {
        border-bottom: none;
    }

    .activity strong {
        font-size: 0.95rem;
    }

    .activity p,
    .activity span {
        color: #64748b;
        font-size: 0.8rem;
    }

    .activity span {
        flex-shrink: 0;
    }

    .footer {
        text-align: center;
        color: #64748b;
        font-size: 0.8rem;
        margin-top: 32px;
    }

    /* Tablets */
    @media (max-width: 1100px) {
        .dashboard {
            grid-template-columns: 200px minmax(0, 1fr);
        }

        .main-content {
            padding: 24px;
        }

        .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    /* Celulares */
    @media (max-width: 700px) {
        .dashboard {
            grid-template-columns: 1fr;
        }

        .sidebar {
            padding: 16px;
            gap: 16px;
        }

        .sidebar nav {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .sidebar nav a {
            font-size: 0.85rem;
            padding: 8px;
        }

        .sidebar-footer {
            display: none;
        }

        .main-content {
            padding: 16px;
        }

        .topbar {
            align-items: flex-start;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 24px;
        }

        .topbar h1 {
            font-size: 1.5rem;
        }

        .stats-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .card,
        .chart-card,
        .activity-card {
            padding: 18px;
        }

        .activity {
            align-items: flex-start;
            flex-direction: column;
            gap: 6px;
        }
    }

    /* Telas pequenas */
    @media (max-width: 360px) {
        .section-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .sidebar nav a {
            font-size: 0.8rem;
        }
    }
</style>

</head><body><div class="dashboard">

    <!-- Sidebar -->
    <aside class="sidebar">
        <h2 class="logo">Dash<span>board</span></h2>

        <nav>
            <a href="#" class="active">📊 Visão geral</a>
            <a href="#">📈 Relatórios</a>
            <a href="#">📁 Projetos</a>
            <a href="#">👥 Usuários</a>
            <a href="#">⚙️ Configurações</a>
        </nav>

        <div class="sidebar-footer">
            <p>Painel administrativo</p>
        </div>
    </aside>

    <!-- Conteúdo principal -->
    <main class="main-content">

        <header class="topbar">
            <div>
                <h1>Visão geral</h1>
                <p>Acompanhe os indicadores do seu negócio.</p>
            </div>

            <div class="user-profile">
                <div class="avatar">JD</div>
                <span>João Dias</span>
            </div>
        </header>

        <!-- Cards de indicadores -->
        <section class="stats-grid">

            <article class="card">
                <p class="card-label">Faturamento</p>
                <h2>R$ 24.580</h2>
                <span class="positive">↑ 12,5% este mês</span>
            </article>

            <article class="card">
                <p class="card-label">Usuários</p>
                <h2>1.284</h2>
                <span class="positive">↑ 8,2% este mês</span>
            </article>

            <article class="card">
                <p class="card-label">Pedidos</p>
                <h2>356</h2>
                <span class="positive">↑ 5,4% este mês</span>
            </article>

            <article class="card">
                <p class="card-label">Taxa de conversão</p>
                <h2>4,8%</h2>
                <span class="negative">↓ 0,6% este mês</span>
            </article>

        </section>

        <!-- Gráfico -->
        <section class="chart-card">

            <div class="section-header">
                <div>
                    <h2>Desempenho mensal</h2>
                    <p>Faturamento ao longo do ano</p>
                </div>

                <span class="badge">2026</span>
            </div>

            <svg class="chart" viewBox="0 0 700 260"
                 role="img"
                 aria-label="Gráfico ilustrativo do faturamento mensal">

                <!-- Linhas de grade -->
                <g stroke="#e2e8f0" stroke-width="1">
                    <line x1="55" y1="30" x2="680" y2="30"/>
                    <line x1="55" y1="75" x2="680" y2="75"/>
                    <line x1="55" y1="120" x2="680" y2="120"/>
                    <line x1="55" y1="165" x2="680" y2="165"/>
                    <line x1="55" y1="210" x2="680" y2="210"/>
                </g>

                <!-- Valores do eixo vertical -->
                <g fill="#64748b" font-size="11" text-anchor="end">
                    <text x="45" y="34">30 mil</text>
                    <text x="45" y="79">25 mil</text>
                    <text x="45" y="124">20 mil</text>
                    <text x="45" y="169">15 mil</text>
                    <text x="45" y="214">10 mil</text>
                </g>

                <!-- Área do gráfico -->
                <path
                    d="M60 192 L115 165 L170 178 L225 138
                       L280 151 L335 102 L390 124 L445 79
                       L500 92 L555 57 L610 70 L665 30
                       L665 210 L60 210 Z"
                    fill="#c7d2fe"
                    opacity="0.55"
                />

                <!-- Linha do gráfico -->
                <polyline
                    points="60,192 115,165 170,178 225,138
                            280,151 335,102 390,124 445,79
                            500,92 555,57 610,70 665,30"
                    fill="none"
                    stroke="#4f46e5"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />

                <!-- Pontos -->
                <g fill="#4f46e5">
                    <circle cx="60" cy="192" r="4"/>
                    <circle cx="115" cy="165" r="4"/>
                    <circle cx="170" cy="178" r="4"/>
                    <circle cx="225" cy="138" r="4"/>
                    <circle cx="280" cy="151" r="4"/>
                    <circle cx="335" cy="102" r="4"/>
                    <circle cx="390" cy="124" r="4"/>
                    <circle cx="445" cy="79" r="4"/>
                    <circle cx="500" cy="92" r="4"/>
                    <circle cx="555" cy="57" r="4"/>
                    <circle cx="610" cy="70" r="4"/>
                    <circle cx="665" cy="30" r="4"/>
                </g>

                <!-- Meses -->
                <g fill="#64748b" font-size="11" text-anchor="middle">
                    <text x="60" y="235">Jan</text>
                    <text x="115" y="235">Fev</text>
                    <text x="170" y="235">Mar</text>
                    <text x="225" y="235">Abr</text>
                    <text x="280" y="235">Mai</text>
                    <text x="335" y="235">Jun</text>
                    <text x="390" y="235">Jul</text>
                    <text x="445" y="235">Ago</text>
                    <text x="500" y="235">Set</text>
                    <text x="555" y="235">Out</text>
                    <text x="610" y="235">Nov</text>
                    <text x="665" y="235">Dez</text>
                </g>

            </svg>

        </section>

        <!-- Atividades recentes -->
        <section class="activity-card">

            <h2>Atividades recentes</h2>

            <div class="activity">
                <div>
                    <strong>Novo pedido recebido</strong>
                    <p>Pedido #1024 realizado</p>
                </div>
                <span>Há 10 min</span>
            </div>

            <div class="activity">
                <div>
                    <strong>Novo usuário cadastrado</strong>
                    <p>Um novo usuário entrou na plataforma</p>
                </div>
                <span>Há 35 min</span>
            </div>

            <div class="activity">
                <div>
                    <strong>Relatório atualizado</strong>
                    <p>Os dados mensais foram atualizados</p>
                </div>
                <span>Há 1 hora</span>
            </div>

        </section>

        <footer class="footer">
            Dashboard responsivo • 2026
        </footer>

    </main>

</div>

</body>
</html>
